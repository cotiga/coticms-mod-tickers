{
    "name": "cotiga/module-tickers",
    "description": "Module bandeau d'annonces défilant (tickers) pour CotiCMS",
    "type": "library",
    "require": {
        "php": "^8.3",
        "cotiga/coticms-core": "dev-main",
        "laravel/framework": "^13.0",
        "filament/filament": "^5.0"
    },
    "suggest": {
        "cotiga/module-events": "Permet d'alimenter le bandeau avec les événements à venir (Paramètres → Contenu du bandeau)"
    },
    "autoload": {
        "psr-4": {
            "Cotiga\\ModuleTickers\\": "src/",
            "Cotiga\\ModuleTickers\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cotiga\\ModuleTickers\\TickersServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
