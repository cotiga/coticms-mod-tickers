{
    "name": "cotiga/module-tickers",
    "description": "Module bandeau d'annonces défilant (tickers) pour CotiCMS",
    "type": "library",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Cotiga\\ModuleTickers\\": "src/",
            "Cotiga\\ModuleTickers\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cotiga\\ModuleTickers\\TickersServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
